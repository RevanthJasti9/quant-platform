# No API keys are required for V1 (yfinance + SEC EDGAR are both free/keyless).
# SEC EDGAR requires a descriptive User-Agent on every request (their policy, not optional).
SEC_EDGAR_USER_AGENT="Your Name your-email@example.com"

# Optional news providers. Leave blank to keep Yahoo as the only headline feed.
# When configured, Finnhub and Polygon add timestamped, ticker-specific news;
# Yahoo remains a lower-confidence coverage and cross-check source.
POLYGON_API_KEY=
FINNHUB_API_KEY=

# Optional: powers the plain-English summaries (news digests, prediction
# reasons). Free, no card, from console.groq.com/keys. Leave blank to use
# only the local Ollama fallback (src/llm/client.py starts/stops it on
# demand); set this to skip local Ollama entirely under normal operation.
GROQ_API_KEY=

# Cloud-first provider secrets. Leave blank until you connect a recurring-free account.
FMP_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
KAGGLE_USERNAME=
KAGGLE_KEY=
HUGGINGFACE_TOKEN=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
METADATA_DATABASE_URL=
